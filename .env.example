# Copy to .env (or paste keys in /settings — they persist to data/.secrets.json).
# .env is git-ignored; data/.secrets.json is git-ignored. Either works locally.
#
# In production (Vercel / Railway / Render) set these as env vars on the host.
# You only need ONE provider to function — the backend auto-rotates through
# whichever ones are configured, in this order:
#
#   Claude > GPT-4o > Gemini (5-model chain) > Groq > Mistral > OpenRouter > xAI > Together
#
# Free-tier providers (recommended combo: Gemini + Groq + Mistral)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# Paid providers (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# ----------------------------------------------------------------------------
# Production-only (when deploying to Vercel + Railway + Supabase)
# ----------------------------------------------------------------------------

# Supabase — Postgres + Auth + Storage
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Backend URL the frontend should call (in dev, the Next rewrite handles this)
# NEXT_PUBLIC_API_URL=https://your-fastapi.up.railway.app
